NODE_ENV=development
ADMIN_KEY=replace-with-a-long-random-secret
MCP_PATH_TOKEN=replace-with-a-different-long-random-secret
# Production: mount a persistent Render disk at /var/data and set DATA_DIR=/var/data.
# Local development defaults to ./data/local when this is omitted.
DATA_DIR=./data/local

# Development only. Never set this in production. Approval decisions remain disabled.
ALLOW_INSECURE_DEV_AUTH=false

# Remote video host policy. This may be blank only in development, where blank permits public hosts.
# Production requires a non-empty allowlist and refuses to start without one (fail-closed).
VIDEO_ALLOWED_HOSTS=
VIDEO_MAX_BYTES=2147483648
VIDEO_DOWNLOAD_TIMEOUT_MS=900000
VIDEO_CONNECT_TIMEOUT_MS=15000

# API protection and bounded reverse-proxy trust.
API_RATE_LIMIT=300
MCP_RATE_LIMIT=120
# Local development: 0. Set TRUST_PROXY_HOPS=1 when deployed behind Render's proxy.
TRUST_PROXY_HOPS=0

# Optional integrations
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
KTB_STACK_MCP_URL=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GHL_API_KEY=
GHL_LOCATION_ID=
